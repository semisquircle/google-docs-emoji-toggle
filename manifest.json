
{
  "manifest_version": 3,
  "name": "Google Docs Emoji Toggle",
  "version": "1.0.0",
  "description": "Toggle check and cross emojis in Google Docs.",
  "permissions": [
    "activeTab",
    "debugger",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-emoji": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle selected checkbox emoji"
    }
  }
}
